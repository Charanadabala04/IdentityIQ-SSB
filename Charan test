if (logger.isTraceEnabled()) {
    logger.trace("Project status: " + isFullyCommitted);
}

if (isFullyCommitted && doProvisioning) {
    fixRoleTargets(context, identity, application, busRoleName, nativeIdentity, itRoleName);

    // IAMAS-3087
    AuditUtils.createAuditEventsFromProject(project);
}

return isFullyCommitted;
}

/**
 * create a profile
 * @param context
 * @param application
 * @param property
 * @param entitlements
 * @return
 * @throws GeneralException
 */
public static Profile createProfile(SailPointContext context, Application application, String property,
                                    List<String> entitlements) throws GeneralException {
    Filter filter = Filter.containsAll(property, entitlements);

    Profile profile = new Profile();
    profile.addConstraint(filter);
    profile.setApplication(application);
    context.saveObject(profile);

    if (logger.isTraceEnabled()) {
        logger.trace("Exiting createProfile: " + profile.toXml());
    }

    return profile;
}

/**
 * @param context
 * @param profile
 * @param property
 * @param newEntitlements
 * @return
 * @throws GeneralException
 */
public static boolean updateProfile(SailPointContext context, Profile profile, String property,
                                    List<String> newEntitlements) throws GeneralException {
    if (context == null || profile == null || Util.isNullOrEmpty(property) || newEntitlements == null) {
        return false;
    }

    boolean changedProfile = false;

    for (Filter filter : Util.safeIterable(profile.getConstraints())) {
        if (filter instanceof Filter.LeafFilter) {
            Filter.LeafFilter leafFilter = (Filter.LeafFilter) filter;

            if (property.equals(leafFilter.getProperty())) {
                List<String> propValues = Utils.otol(leafFilter.getValue());

                if (propValues != null && !Util.orderInsensitiveEquals(propValues, newEntitlements)) {
                    List<String> newPropValues = new ArrayList<String>();
                    newPropValues.addAll(newEntitlements);
                    profile.setConstraints(Arrays.asList(Filter.containsAll(property, newPropValues)));
                    context.saveObject(profile);
                    context.commitTransaction();
                    changedProfile = true;
                }
            }
        }
    }

    if (changedProfile) {
        return true;
    }

    return false;
}

/**
 * create business or IT role for applications with multiple accounts per identity
 *
 * @param context
 * @param name
 * @param type
 * @param owner
 * @param appName
 * @param container
 * @param itBundles
 * @param profile
 * @param tierLevel
 * @param description
 * @param isCritical
 * @param isRequestable
 * @param isStricter
 * @return
 * @throws GeneralException
 */
public static Bundle createRoleForMultipleAccounts(SailPointContext context, String name, String type,
                                                  Identity owner, String appName, Bundle container, List<Bundle> itBundles,
                                                  Profile profile, String tierLevel,
                                                  String description, boolean isCritical, boolean isRequestable, boolean isStricter)
                                                  throws GeneralException {
    if (Util.isAnyNullOrEmpty(name, type) || owner == null) {
        logger.error(String.format(
            "Cannot create bundle, because one of the following values is null. name (%s), type (%s), owner (%s)",
            name, type, owner));
        return null;
    }

    Bundle bundle = new Bundle();
    bundle.setName(name);
    bundle.setDisplayName(name);
    bundle.setOwner(owner);
    bundle.addInheritance(container);
    bundle.setAttribute(ExtendedAttributes.CRITICAL_ATTRIBUTE, isCritical);

    if (Util.isNotNullOrEmpty(tierLevel)) {
        bundle.setAttribute(ExtendedAttributes.BUNDLE_DBG_TIER_LEVEL, tierLevel);
        bundle.setAttribute(ExtendedAttributes.BUNDLE_DBG_STRICTER_TIER_LEVEL, Boolean.valueOf(isStricter));

        if (!AccountSchema.DBG_DEFAULT_TIER_LEVEL.equals(tierLevel)) {
            String classificationName = ClassificationUtils.getPrivilegedTierClassificationName(tierLevel);

            if (Util.isNotNullOrEmpty(classificationName)) {
                ClassificationUtils.addObjectClassification(context, bundle, classificationName, false, true, false);
            }
        }
    }

    if (Util.isNotNullOrEmpty(description)) {
        bundle.addDescription(EN_US, description);
    }

    if (RoleType.BUSINESS.toString().equals(type)) {
        if (itBundles != null && !itBundles.isEmpty()) {
            bundle.setRequirements(itBundles);
        } else {
            logger.error(name + " no IT roles provided.");
            return null;
        }

        Describer describer = new Describer(bundle);
        describer.addDescriptions(bundle.getDescriptions());
        describer.saveLocalizedAttributes(context);
        bundle.setType(type);
        bundle.setAttribute(ExtendedAttributes.BUNDLE_REQUESTABLE, isRequestable);
        bundle.setAttribute(ExtendedAttributes.CERTIFIABLE_ATTRIBUTE, Boolean.FALSE);
        bundle.setAllowMultipleAssignments(true);

    } else if (RoleType.IT.toString().equals(type)) {
        if (profile == null) {
            logger.warn("Profile is null.");
            return null;
        }

        bundle.setType(type);
        bundle.assignProfiles(Arrays.asList(profile));
        bundle.setAllowDuplicateAccounts(true);
        bundle.setAttribute(ExtendedAttributes.BUNDLE_REQUESTABLE, Boolean.FALSE);
        bundle.setAttribute(ExtendedAttributes.CERTIFIABLE_ATTRIBUTE, Boolean.TRUE);
    }

    return bundle;
}

/**
 * reads and parses the tier level
 * @param bundle
 * @return
 */
public static String getTierLevel(Bundle bundle) {
    if (bundle == null) {
        return AccountSchema.DBG_DEFAULT_TIER_LEVEL;
    }

    String tierLevel = Util.otos(bundle.getAttribute(ExtendedAttributes.BUNDLE_DBG_TIER_LEVEL));

    if (Util.isNullOrEmpty(tierLevel)) {
        return AccountSchema.DBG_DEFAULT_TIER_LEVEL;
    }

    return tierLevel;
}
